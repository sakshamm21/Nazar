# Dependencies
/node_modules

# Next.js build output
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Environment (secrets): only the documented template is committed
.env*
!.env.example

# Vercel project link
.vercel

# Local embedded database (PGlite), created by `npm run dev`
/.data

# Eval run reports (the cases, recordings and baseline are committed; each run's output is not)
/evals/runs

# Test output
/coverage
/playwright-report
/test-results

# Editor and assistant tooling, not part of the app
/.agents
/.claude
skills-lock.json

# OS and logs
.DS_Store
*.pem
npm-debug.log*
