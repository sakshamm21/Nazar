{
  "name": "nazar",
  "version": "2.2.0",
  "private": true,
  "description": "Nazar: an AI portfolio watchdog for Indian retail investors",
  "scripts": {
    "dev": "tsx --conditions=react-server scripts/dev.ts",
    "build": "tsx --conditions=react-server scripts/migrate.ts && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "demo:reset": "tsx --conditions=react-server scripts/reset-local.ts",
    "nse:refresh": "tsx --conditions=react-server scripts/refresh-nse-master.ts",
    "catalog:refresh": "tsx --conditions=react-server scripts/refresh-catalog.ts",
    "pipeline:run": "tsx --conditions=react-server scripts/run-pipeline.ts",
    "eval:guard": "tsx --conditions=react-server evals/guard.ts",
    "eval:agent": "tsx --conditions=react-server evals/run.ts",
    "eval:archive": "node evals/archive-runs.mjs",
    "eval:harvest": "tsx --conditions=react-server evals/harvest.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.133",
    "@ai-sdk/react": "^2.0.274",
    "@electric-sql/pglite": "^0.5.8",
    "@neondatabase/serverless": "^1.2.0",
    "ai": "^5.0.271",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.50.0",
    "motion": "^14.0.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "unpdf": "^1.8.1",
    "yahoo-finance2": "^4.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
