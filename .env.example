# ── Required ──────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Session signing secret. Generate one:  npx auth secret   or   openssl rand -base64 32
# Don't change it after launch: device logins are derived from it.
NEXTAUTH_SECRET=

# ── Database ──────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, Vercel Postgres, local…).
# Leave empty locally to use the embedded PGlite database in ./.data (zero setup).
# REQUIRED on Vercel for persistent chat history, watchlists and alerts.
DATABASE_URL=

# ── Optional: "Sign in with Google / GitHub" (sync across devices) ──
# Device-fingerprint login always works; these add real accounts on top.
# Callback URL to register: <your-site>/api/auth/callback/google  (or /github)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_ID=
# GITHUB_SECRET=
# Needed for OAuth in production — your public URL, e.g. https://stockai.vercel.app
# NEXTAUTH_URL=http://localhost:3000

# ── Optional: cost & abuse limits (defaults shown; 0 disables) ──
# RATE_LIMIT_PER_MINUTE=6
# RATE_LIMIT_PER_DAY=60
# RATE_LIMIT_PER_DAY_IP=150
# USER_DAILY_BUDGET_USD=0.5
# GLOBAL_DAILY_BUDGET_USD=10
# MAX_INPUT_CHARS=2000
# Comma-separated model ids users may pick (default: all your key can access)
# ALLOWED_MODELS=gpt-6-luna,gpt-5.4-mini,gpt-5.4-nano

# ── Optional: guardrails ──────────────────────────────────
# Fast model that blocks off-topic requests (coding, essays…) before the main agent runs.
# GUARD_MODEL=gpt-4.1-mini
# GUARD_DISABLED=1

# ── Optional: product analytics ──────────────────────────
# /insights is open in development; in production open /insights?key=<INSIGHTS_KEY>
# INSIGHTS_KEY=

# ── Optional: background alert checks (Vercel Cron, see vercel.json) ──
# CRON_SECRET=
