# Nazar environment variables. Copy to .env.local for local overrides; set the same names on Vercel.
# Locally, NOTHING here is required: `npm run dev` runs on an embedded database with demo data.

# ── Core ──────────────────────────────────────────────────────────────────────
# OpenRouter key for the Ask tab only (everything else is arithmetic, no AI cost). Ask is disabled without a key.
# One key reaches every model in src/lib/ask/models.ts: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Used only when OPENROUTER_API_KEY is empty: Ask then calls OpenAI directly.
OPENAI_API_KEY=
# Signs sessions and one-click email links. Required in production, at least 32 chars: openssl rand -base64 32
AUTH_SECRET=
# Nazar's own Postgres (Neon free tier works). Leave empty locally to use PGlite in ./.data/nazar.
NAZAR_DATABASE_URL=
# Fallback name for the database URL. Never point either at StockAI v1's database (migrations refuse to).
DATABASE_URL=
# Public URL used in email links. Defaults to the Vercel production URL, then http://localhost:3000.
APP_URL=

# ── Email (Brevo free tier, 300/day) ──────────────────────────────────────────
# Brevo API key (Brevo → SMTP & API → API keys). Without it, emails are skipped and logged.
BREVO_API_KEY=
# Sender, verified in Brevo, e.g. Nazar <alerts@yourdomain.com>
MAIL_FROM=
# Safety margin under Brevo's free limit: digests stop for the day after this many sends.
EMAIL_DAILY_CAP=250
# 1 switches all sending off even with keys present (used by e2e tests).
EMAIL_DISABLED=
# true shows sign-up/reset codes on screen in production when an email could not be delivered.
EXPOSE_VERIFICATION_CODES=false

# ── Jobs (Vercel Cron, see vercel.json) ───────────────────────────────────────
# Bearer token Vercel Cron sends to /api/cron/*; requests without it are rejected.
CRON_SECRET=
# Parallel symbols per nightly batch (keep low: Yahoo rate-limits).
PIPELINE_CONCURRENCY=4
# Parallel Yahoo calls for interactive pages (Ask, stock pages).
YAHOO_CONCURRENCY=6
# 0 turns off company-specific Google News headlines on alerts.
NEWS_ENABLED=1
# Set to 0 to stop the pipeline consulting the second market-data source when the primary one
# misses a symbol. On by default: it is what keeps a rate-limited evening from leaving stale prices.
FALLBACK_PROVIDER=1

# ── Accounts and admin ───────────────────────────────────────────────────────
# Comma-separated emails that can open /insights (product analytics).
ADMIN_EMAILS=
# Alternative /insights access for a read-only shared view: enter it on /insights and it is kept in
# an httpOnly cookie (it is never put in the URL).
INSIGHTS_KEY=
# false hides the one-click test accounts on the sign-in page.
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true
# Link to StockAI v1 (legacy) shown in the landing page footer.
NEXT_PUBLIC_LEGACY_URL=

# ── Ask (AI) cost limits: the only paid usage. 0 disables a limit ───────────
# Questions per user per minute.
RATE_LIMIT_PER_MINUTE=6
# Questions per signed-in user per day.
RATE_LIMIT_PER_DAY=40
# Questions per demo visitor per day.
RATE_LIMIT_PER_DAY_DEMO=5
# Questions per network (hashed IP) per day.
RATE_LIMIT_PER_DAY_IP=100
# OpenAI spend cap per user per day, in USD.
USER_DAILY_BUDGET_USD=0.3
# OpenAI spend cap for the whole app per day, in USD. Ask pauses until tomorrow when reached.
GLOBAL_DAILY_BUDGET_USD=3
# Longest question accepted, in characters.
MAX_INPUT_CHARS=2000

# ── Ask (AI) tuning ──────────────────────────────────────────────────────────
# Comma-separated model ids users may pick in Ask (default: every chat model the key can use).
ALLOWED_MODELS=
# The model "Auto" uses for everything except a deep dive, e.g. z-ai/glm-5.3-flash for open weights.
# Empty: the default in src/lib/ask/models.ts, which lists how each model scored.
ASK_AUTO_MODEL=
# Fast model that keeps Ask on-topic before the main model runs. On OpenRouter a bare id is read as openai/<id>.
GUARD_MODEL=gpt-4.1-mini
# 1 turns the on-topic classifier off (the system prompt still applies).
GUARD_DISABLED=
# What happens to a sentence in an answer that reads as advice: enforce (default) leaves it out,
# shadow only records it, off does neither.
ASK_ADVICE_GUARD=
# OpenAI-compatible endpoint, only if you route through a proxy.
OPENAI_BASE_URL=

# ── Local development ────────────────────────────────────────────────────────
# Port for `npm run dev`.
PORT=3000
# PGlite folder (e2e tests use .data/e2e so they never touch your local data).
NAZAR_PGLITE_DIR=
# pino log level: debug | info | warn | error | silent
LOG_LEVEL=info
